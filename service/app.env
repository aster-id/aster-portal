# Node
TZ=UTC
PORT=4075
HOST=0.0.0.0
NODE_ENV=production

# App
LOG_LEVEL=info
APP_URL=https://portal.aster.place/
# Generate an APP_KEY with: node ace generate:key or openssl rand -hex 32
APP_KEY="${APP_KEY}"

DATABASE_AUTOMIGRATE=true
DATABASE_PATH=/data/production.sqlite3

ATPROTO_OAUTH_CLIENT_ID=https://pds.aster.id/oauth-client-metadata.json
OAUTH_SERVICE=https://pds.aster.id/
# Required at deploy time: enables bare-username login (e.g. `sebastian` →
# `sebastian.aster.id`) and gates logins to Aster accounts when
# ALLOW_EXTERNAL_LOGINS is false. See BRANDING.md §9.
ATPROTO_HANDLE_DOMAIN=aster.id

# Session
SESSION_DRIVER=cookie
